# Neon PostgreSQL Remote Database Credentials
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/[dbname]?sslmode=require"
DIRECT_URL="postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Backblaze B2 S3-Compatible Cloud Storage
B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
B2_REGION="us-west-004"
B2_KEY_ID="your_backblaze_key_id"
B2_APP_KEY="your_backblaze_application_key"
B2_BUCKET_NAME="your-private-dv-bucket"
